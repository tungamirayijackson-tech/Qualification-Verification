# Copy to .env and fill in before `docker compose up`.
#
# Nothing here has a default in the application. A missing secret stops start-up with a clear
# message rather than falling back to a value that a repository could contain -- which is the
# most common way a project ends up shipping a key everybody knows.
#
# Generate a fresh set:
#   QVS_FIELD_KEY:        openssl rand -base64 32     (must decode to exactly 32 bytes)
#   QVS_NATIONAL_ID_SALT: openssl rand -hex 24
#   QVS_IP_SALT:          openssl rand -hex 24
#   QVS_JWT_SECRET:       openssl rand -hex 32        (at least 32 bytes, or HS256 is HS256 in name only)
#   GRAFANA_PASSWORD:     openssl rand -base64 18

QVS_FIELD_KEY=
QVS_NATIONAL_ID_SALT=
QVS_IP_SALT=
QVS_JWT_SECRET=

# The first administrator. A freshly built system has an empty user table, and every account
# is created by an administrator -- so without these there is nobody to sign in as and no way
# to make anybody. Set them once, start the system, sign in, and set up the second factor the
# ADMIN role requires; after that these are dead weight and can be removed.
#
# The application uses them only while the register holds no accounts at all, so this cannot
# be used to add an administrator to a running system. The password must be at least 12
# characters, is stored only as a bcrypt hash, and is never written to a log.
#   QVS_BOOTSTRAP_ADMIN_PASSWORD: openssl rand -base64 18
QVS_BOOTSTRAP_ADMIN_EMAIL=
QVS_BOOTSTRAP_ADMIN_PASSWORD=

# Grafana's own admin login. It reads one Prometheus that reads one API and holds nothing
# else, but it still gets a password rather than the default admin/admin -- a default
# credential in a compose file is how a default credential reaches production.
GRAFANA_USER=qvs
GRAFANA_PASSWORD=

# Optional. `dev` seeds demo institutions, qualifications, credentials and one account per
# role. Never use `dev` anywhere real -- it creates accounts with a published password.
# QVS_PROFILE=dev
