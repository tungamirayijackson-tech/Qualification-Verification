# Applies to every editor the team uses, so "coding standards compliance" starts before
# Checkstyle and ESLint rather than being enforced only at the gate.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,js,json,yml,yaml,html,scss,css,md}]
indent_size = 2

[*.{kts,gradle}]
indent_size = 4

[*.md]
# Two trailing spaces is a hard line break in Markdown; trimming them silently reflows text.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
